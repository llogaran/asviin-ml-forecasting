# ── Asviin ML Forecasting ──────────────────────────────────────────────────
# Copy to `.env` for local development. Never commit real credentials.

MLFC_ENV=dev
MLFC_DATA_DIR=./data
MLFC_ARTIFACTS_DIR=./artifacts
MLFC_RANDOM_SEED=42
# `champion` resolves the champion model from artifacts/models/registry.json
MLFC_MODEL_NAME=champion

# Optional: protect the API with a static key sent as the `X-API-Key` header.
MLFC_API_KEY=

# Optional: OpenAI-compatible endpoint to enable the LLM agent mode.
# Without it the agent still works in deterministic offline mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated CORS origins ("*" by default).
MLFC_CORS_ORIGINS=*
